# APP_URL: The URL where this applet is hosted (used for invite/reset links & origin checks).
APP_URL="http://localhost:3000"

# MONGODB_URI: Required for production persistent storage with MongoDB Atlas.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/npp_issues?retryWrites=true&w=majority
MONGODB_URI=""

# SESSION_SECRET: 64-char random hex string for signing/verifying server-side session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ENCRYPTION_KEY: 64-char random hex string (32 bytes) for encrypting TOTP MFA secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# BOOTSTRAP_ADMIN_SECRET: Private one-time secret required to create the first Super Admin account.
# Remove or unset after the first Super Admin account is created.
BOOTSTRAP_ADMIN_SECRET=""

# SMTP Email Configuration (Optional - required for outbound invite/notification emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NPP Issue Portal <no-reply@example.org>"
